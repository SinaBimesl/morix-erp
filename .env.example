# Copy to .env and change the values. Never commit .env.
ENVIRONMENT=development

POSTGRES_USER=merp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=merp

# Optional database timeouts (defaults shown).
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=30000
# MIGRATION_LOCK_TIMEOUT_MS=5000

# Host address and port for the backend API.
# 127.0.0.1 keeps it local; use 0.0.0.0 only to expose it on all interfaces.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
